<?xml version="1.0"?>
<ruleset name="SpatBridge">
    <description>PSR-12 coding standard for the SpatBridge FreeScout module.</description>

    <file>Console</file>
    <file>Database</file>
    <file>Features</file>
    <file>Http</file>
    <file>Providers</file>
    <file>Services</file>
    <file>scripts</file>
    <file>Tests</file>

    <arg name="extensions" value="php"/>
    <arg value="p"/>

    <!--
        Blade templates mix raw HTML with PHP directives (@if, {{ }}, etc.) and
        are not valid standalone PHP files, so PSR-12 structural rules (file
        layout, closing tags, one class per file...) don't apply to them.
        Excluded from linting rather than fought against.
    -->
    <exclude-pattern>*/Resources/views/*</exclude-pattern>

    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <exclude-pattern>*/Tests/*</exclude-pattern>
    </rule>

    <!--
        Laravel's migrator instantiates a migration by the class name it
        derives from the file name, in the global namespace, so migrations
        can't have a namespace.
    -->
    <rule ref="PSR1.Classes.ClassDeclaration.MissingNamespace">
        <exclude-pattern>*/Database/Migrations/*</exclude-pattern>
    </rule>

    <rule ref="PSR12"/>
</ruleset>
